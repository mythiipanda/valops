---
import '../styles.css';
import { Matchup, OddsTable, SwingBoard, EloTable, CompBoard } from '../components/islands';
import { readFileSync, existsSync } from 'node:fs';

const has = existsSync(new URL('../../public/data.json', import.meta.url));
const data = has ? JSON.parse(readFileSync(new URL('../../public/data.json', import.meta.url), 'utf8')) : null;
const hasComps = existsSync(new URL('../../public/comps.json', import.meta.url));
const comps = hasComps ? JSON.parse(readFileSync(new URL('../../public/comps.json', import.meta.url), 'utf8')) : null;

const gname = (b: any, id: number) => b.teams.find((t: any) => t.id === id)?.name ?? String(id);
const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const gbracket = (b: any): string => {
  const BW = 200, CW = 44, RH = 30, BH = 60;
  const X = [0, 280, 560];
  const INK = "#111111", GRAY = "rgba(0,0,0,0.4)", LINE = "#eceae4",
        ACC = "#a36844", CONN = "rgba(0,0,0,0.25)", LAB = "#444444";
  const nm = (id: number) => esc(gname(b, id));
  const label = (x: number, y: number, t: string) =>
    `<text x="${x}" y="${y - 10}" font-size="12" font-weight="600" fill="${LAB}">${t}</text>`;
  const match = (x: number, y: number, m: any, lab: string): string => {
    const pa = m.w === m.a ? m.pw : 1 - m.pw;
    let s = label(x, y, lab);
    s += `<rect x="${x}" y="${y}" width="${BW}" height="${BH}" rx="6" fill="#ffffff" stroke="${LINE}"/>`;
    s += `<line x1="${x}" y1="${y + RH}" x2="${x + BW}" y2="${y + RH}" stroke="${LINE}"/>`;
    s += `<line x1="${x + BW - CW}" y1="${y}" x2="${x + BW - CW}" y2="${y + BH}" stroke="${LINE}"/>`;
    [{ id: m.a, p: pa }, { id: m.b, p: 1 - pa }].forEach((r, i) => {
      const win = r.id === m.w, yy = y + i * RH, cx = x + BW - CW;
      const fg = win ? INK : GRAY, fw = win ? ' font-weight="600"' : "";
      s += `<text x="${x + 12}" y="${yy + 19}" font-size="12.5"${fw} fill="${fg}">${nm(r.id)}</text>`;
      if (win) s += `<rect x="${cx}" y="${yy}" width="${CW}" height="${RH}" fill="${ACC}"/>`;
      s += `<text x="${cx + CW / 2}" y="${yy + 19}" font-size="12.5" text-anchor="middle"${fw} fill="${win ? "#ffffff" : GRAY}" style="font-variant-numeric: tabular-nums">${Math.round(r.p * 100)}</text>`;
    });
    return `<g>${s}</g>`;
  };
  const qualified = (x: number, y: number, id: number, tag: string): string => {
    let s = label(x, y, "Qualified");
    s += `<rect x="${x}" y="${y}" width="${BW}" height="${BH}" rx="6" fill="#ffffff" stroke="${LINE}"/>`;
    s += `<rect x="${x}" y="${y}" width="3" height="${BH}" fill="${ACC}"/>`;
    s += `<text x="${x + 14}" y="${y + 36}" font-size="13" font-weight="600" fill="${INK}">${nm(id)}</text>`;
    s += `<text x="${x}" y="${y + BH + 18}" font-size="11.5" fill="${GRAY}">${tag}</text>`;
    return `<g>${s}</g>`;
  };
  const g = b.gsl;
  const P = (d: string) => `<path d="${d}" fill="none" stroke="${CONN}" stroke-width="1.5"/>`;
  let s = `<svg viewBox="-8 -30 788 340" xmlns="http://www.w3.org/2000/svg" font-family="Inter Variable, Inter, -apple-system, sans-serif">`;
  s += P("M200,30 H230 V70 H280") + P("M200,140 H230 V100 H280");
  s += P("M200,30 H230 V235 H200") + P("M200,140 H230 V265 H200");
  s += P("M200,250 H210 V265 H280");
  s += P("M480,85 H560") + P("M480,100 H520 V235 H280") + P("M480,250 H560");
  s += match(X[0], 0, g.openers[0], "Opening");
  s += match(X[0], 110, g.openers[1], "");
  s += match(X[1], 55, g.winners, "Winner's");
  s += match(X[0], 220, g.elim, "Elimination");
  s += match(X[1], 220, g.decider, "Decider");
  s += qualified(X[2], 55, g.winners.w, "2-0");
  s += qualified(X[2], 220, g.decider.w, "2-1");
  return s + `</svg>`;
};
---
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>VALOPS Champions Shanghai 2026 predictor</title>
</head>
<body>
<div class="wrap">
  <header class="hero">
    <h1>Champions Shanghai</h1>
    {data && <p class="favline"><strong>{data.teams[0].name}</strong> {(data.teams[0].title * 100).toFixed(1)}% to win</p>}
    <p class="dateline">Sep 24 to Oct 18 · 16 teams</p>
  </header>

  {data && (<>
  <section>
    <h2>Title odds</h2>
    <OddsTable teams={data.teams} client:load />
  </section>

  <section>
    <h2>Matchup</h2>
    <Matchup teams={data.teams} matchups={data.matchups} client:load />
  </section>

  <section>
    <h2>Groups</h2>
    <p class="sub">Most likely path through each group — favorites win every match. Full advance odds below each bracket.</p>
    <div class="groups">
    {Object.entries(data.bracket).map(([g, b]) => (
      <div class="group">
        <div class="grouphead"><span>Group {g}</span></div>
        <div class="gsvgwrap"><div class="gsvg" set:html={gbracket(b)} /></div>
        <div class="gadvance">
          <div class="gadvance-title">To advance</div>
          {b.odds.sort((x, y) => y.adv - x.adv).map(o => (
            <div class="grow">
              <div class="grow-top"><span class="gname">{o.name}</span>
              <span class="num">{(o.adv * 100).toFixed(0)}</span></div>
              <div class="bar"><i style={{ width: `${o.adv * 100}%` }} /></div>
              <div class="gdetail">2-0 {(o.first * 100).toFixed(0)} · 2-1 {(o.second * 100).toFixed(0)}</div>
            </div>
          ))}
        </div>
      </div>
    ))}
    </div>
  </section>

  <section>
    <h2>Team Elo</h2>
    <p class="sub">Roster-mean player Elo across every 2026 VCT regional team. Form is Stage-2-only Elo: each team's pre-Stage-2 rating updated on Stage 2 series alone. &#916; is form minus Elo.</p>
    <EloTable teams={data.all_teams ?? data.teams} client:load />
  </section>

  <section>
    <h2>Teams</h2>
    {data.teams.map(t => (
      <div class="team">
        <div class="teamhead"><span>{t.name}</span>
        <span class="num mut">avg {t.roster.length ? Math.round(t.roster.reduce((s, p) => s + p.elo, 0) / t.roster.length) : '–'}</span></div>
        {t.roster.map(p => (
          <div class="prow"><span>{p.name}</span>
          <div class="bar"><i style={{ width: `${Math.max(4, Math.min(100, (p.elo - 1400) / 4))}%` }} /></div>
          <span class="num mut">{Math.round(p.elo)}</span></div>
        ))}
      </div>
    ))}
  </section>

  <section>
    <h2>Team Stats</h2>
    <table class="sortable">
      <thead><tr><th></th>
        <th title="Attack round win %">atk</th>
        <th title="Defense round win %">def</th>
        <th title="Pistol round win %">pistol</th>
        <th title="First-half round win %">1st</th>
        <th title="Second-half round win %">2nd</th>
        <th title="Share of rounds played in overtime">OT</th>
        <th title="Maps won after trailing by 4+ rounds">comeback</th>
        <th title="Maps lost after leading by 4+ rounds">choke</th>
      </tr></thead>
      <tbody>
        {(() => {
          const rows = data.dna;
          const keys = ['atk','dfn','pistol','h1','h2','ot','comeback','choke'];
          const lo = {}, hi = {};
          keys.forEach(k => { lo[k] = Math.min(...rows.map(r => r[k])); hi[k] = Math.max(...rows.map(r => r[k])); });
          return rows.map(r => (
            <tr><td>{r.name}</td>{keys.map(k => (
              (r[k] === hi[k] || r[k] === lo[k])
                ? <td class="num"><strong>{r[k].toFixed(1)}</strong></td>
                : <td class="num">{r[k].toFixed(1)}</td>
            ))}</tr>
          ));
        })()}
      </tbody>
    </table>
  </section>

  <section>
    <h2>2026 Round Swing leaders</h2>
    <p class="sub">Round-win probability added per 100 rounds, agent-adjusted and shrunk. The full-year view weights recent form and international games more; use the stage filter to slice it.</p>
    <SwingBoard boards={data.swing_boards} client:load />
  </section>

  {comps && (
  <section>
    <h2>Best comps</h2>
    <p class="sub">Best 5-agent comp per map from 2026 games, scored by wins above Elo expectation. Shrunk toward zero by sample size.</p>
    <CompBoard comps={comps} client:load />
  </section>
  )}

  <section class="method">
    <h2>How it works</h2>
    <div class="team">
      <div class="teamhead"><span>The data</span></div>
      <p>Every pro series, map by map and round by round: scores, kills, agents, economy. It lands in one database of teams, players, and maps, and every feature below is computed from history before match day. Nothing peeks at the future.</p>
    </div>
    <div class="team">
      <div class="teamhead"><span>Player Elo</span></div>
      <div class="formula">R&#8242; = R + K(S &#8722; E)</div>
      <div class="formula">E = 1 / (1 + 10<sup>(R<sub>b</sub> &#8722; R<sub>a</sub>)/400</sup>)</div>
      <p>Ratings live on players, not teams, so they survive roster moves. Beating a stronger team moves a rating more. Every offseason, ratings drift 30% back toward average.</p>
      <p>Two things changed in v4. First, credit for a series win is split by Round Swing, not kills: each kill is worth the change in round-win probability it caused, so a 1v3 clutch pays more than a cleanup kill. Second, ratings shrink toward average by sample size instead of a hard cutoff: a player with n maps counts as n/(n+20) themselves and 20/(n+20) average.</p>
      <p>A team's rating is the mean of its five players, minus a penalty for a new lineup. The model runs two trackers side by side: a slow one for true strength and a fast one that reacts 1.5x to every result and never regresses. The site's Form column is different: it takes each team's pre-Stage-2 rating and updates it on Stage 2 series alone, so a Stage 2 title run shows up even if the rest of the year was mediocre.</p>
    </div>
    <div class="team">
      <div class="teamhead"><span>The features</span></div>
      <p>Each matchup becomes a list of A-minus-B gaps: rating, recent form, last-60-day stats (rating, ACS, KAST, first-kill differential), series win rate, strength of schedule, days of rest, agent-composition coverage, pistol and retake rates. Small samples get smoothed toward average, so a three-map hot streak cannot break the math.</p>
    </div>
    <div class="team">
      <div class="teamhead"><span>Win probability</span></div>
      <div class="formula">P(A beats B) = 1 / (1 + e<sup>&#8722;w&#183;x</sup>)</div>
      <p>A plain logistic regression turns the gaps into a probability. The biggest weights sit on recent form, series win rate, and pistol rounds; features are correlated, so single weights are not all intuitive.</p>
    </div>
    <div class="team">
      <div class="teamhead"><span>Evaluation</span></div>
      <p>We train on past years and test on the next one. Lower Brier is better.</p>
      <div class="brier">
        {data.validation.filter(v => v.test).map((v) => (
          <div class="brow"><span class="blabel">{v.test} model</span><div class="btrack"><i style={`width: ${(v.brier / 0.3 * 100).toFixed(1)}%`}></i></div><span class="num">{v.brier.toFixed(3)}</span></div>
          <div class="brow dim"><span class="blabel">{v.test} coinflip</span><div class="btrack"><i style="width: 83.3%"></i></div><span class="num">0.250</span></div>
        ))}
      </div>
      <p>At the extremes the model is overconfident: matchups priced at 77% win 62% of the time.</p>
      <p>A change ships only if walk-forward Brier improves.</p>
    </div>
    <div class="team">
      <div class="teamhead"><span>Simulation</span></div>
      <p>We run 10,000 sims over the real groups and bracket.</p>
    </div>
    <div class="team">
      <div class="teamhead"><span>Player scores</span></div>
      <div class="formula">swing(kill) = P(win round | after) &#8722; P(win round | before)</div>
      <p>Every kill is worth the round-win probability it added. A first blood in a 1v1 is worth far more than a trade in a 5v2, so stat padding dies here. The probabilities come from 2023-2024 rounds, keyed on attackers alive, defenders alive, and whether the spike is planted. Credit is zero-sum: what the killer gains, the victim loses. Plants and defuses move the state but earn no direct credit.</p>
      <div class="formula">Round Swing = &#931; (swing &#8722; agent average) / rounds &#215; 100</div>
      <p>Each player is measured against the prior-year average for their agent, so a duelist is judged against duelists. The result is per 100 rounds, then shrunk toward zero for small samples. The full-year board weights recent splits more heavily and counts international games more than regional ones, the same way the model trusts recent form and big stages; stage filters show each split raw. This replaced the old kill-share swing and the space metric.</p>
    </div>
    <table class="sortable">
      <thead><tr><th>Split</th><th>Brier</th><th>Acc</th><th>n</th></tr></thead>
      <tbody>
        {data.validation.filter(v => v.test).map((v) => (
          <tr><td class="num">thru {v.train_thru} → {v.test}</td>
          <td class="num">{v.brier}</td><td class="num">{(v.acc * 100).toFixed(1)}%</td><td class="num">{v.n_test}</td></tr>
        ))}
        <tr><td class="num">coinflip</td>
        <td class="num">{data.validation.find(v => v.baseline_coinflip_brier)?.baseline_coinflip_brier}</td><td class="num">–</td><td class="num">–</td></tr>
      </tbody>
    </table>
  </section>
  </>)}
</div>
<script>
document.querySelectorAll('table.sortable').forEach((table) => {
  const ths = [...table.querySelectorAll('thead th')];
  const tbody = table.querySelector('tbody');
  let key = -1, dir = 1;
  const clean = (el) => el.textContent.trim().replace(/[–%+]/g, '');
  ths.forEach((th, i) => {
    th.classList.add('sortth');
    th.addEventListener('click', () => {
      if (key === i) dir = -dir; else { key = i; dir = 1; }
      const rows = [...tbody.rows];
      const numeric = rows.every((r) => {
        const t = clean(r.cells[i]);
        return t === '' || !isNaN(Number(t));
      });
      rows.sort((a, b) => {
        if (numeric) return (parseFloat(clean(a.cells[i])) - parseFloat(clean(b.cells[i]))) * dir;
        return clean(a.cells[i]).localeCompare(clean(b.cells[i])) * dir;
      });
      rows.forEach((r) => tbody.appendChild(r));
      ths.forEach((h) => { h.textContent = h.textContent.replace(/ [↑↓]$/, ''); });
      th.textContent += dir === 1 ? ' ↑' : ' ↓';
    });
  });
});
</script>
</body>
</html>
